{
  "id": "calculator",
  "name": "Calculator",
  "description": "Perform mathematical calculations locally on your device. Supports basic arithmetic, parentheses, percentages, and operator precedence.",
  "version": "1.0.0",
  "category": "Utilities",
  "icon": "calculator",
  "executionType": "local",
  "runtimeRequired": false,
  "inputs": [
    {
      "id": "expression",
      "label": "Expression",
      "type": "text",
      "required": true,
      "placeholder": "e.g. (2 + 3) * 4",
      "description": "Mathematical expression to evaluate"
    }
  ],
  "outputs": [
    {
      "id": "result",
      "label": "Result",
      "type": "number",
      "description": "Calculation result"
    }
  ],
  "controls": {
    "pausable": false,
    "resumable": false,
    "cancellable": false
  }
}
